# Public base URL, no trailing slash. Used for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=

# Resend API key for contact form delivery. https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender on the Resend account, e.g. "Website <noreply@example.com>".
CONTACT_FROM_EMAIL=

# Inbox that receives consultation requests.
CONTACT_TO_EMAIL=
